# ESP32-S3-ETH onboard W5500 (ESP-IDF 5.5.x built-in SPI Ethernet driver)
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# Validate HTTPS OpenWeatherMap servers with the ESP-IDF certificate bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Dynamic buffer allocation for mbedTLS
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# Static IP option (disabled by default since DHCP on 192.168.1.1 is now working)
# CONFIG_ETH_USE_STATIC_IP is not set
