# ESP32-S3-ETH onboard W5500 (ESP-IDF 5.5.x built-in SPI Ethernet driver)
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# Validate HTTPS OpenWeatherMap servers with the ESP-IDF certificate bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Use Static IP to bypass rogue DHCP servers on the switch (assigns directly to 192.168.1.x)
CONFIG_ETH_USE_STATIC_IP=y
CONFIG_ETH_STATIC_IP_ADDR="192.168.1.222"
CONFIG_ETH_STATIC_NETMASK="255.255.255.0"
CONFIG_ETH_STATIC_GATEWAY="192.168.1.1"
CONFIG_ETH_STATIC_DNS_MAIN="192.168.1.1"
CONFIG_ETH_STATIC_DNS_BACKUP="8.8.8.8"